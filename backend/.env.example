# Environment
NODE_ENV=development
PORT=5000

# Database
# Atlas example: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/edumaster
MONGO_URI=mongodb://127.0.0.1:27017/edumaster

# JWT
JWT_ACCESS_SECRET=replace_with_a_long_random_string
JWT_REFRESH_SECRET=replace_with_a_different_long_random_string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Cookies
COOKIE_DOMAIN=
# Cookie lifetimes in milliseconds (separate from JWT expiry)
ACCESS_COOKIE_MAX_AGE=900000
REFRESH_COOKIE_MAX_AGE=604800000

# CORS
CLIENT_URL=http://localhost:5173

# Security
BCRYPT_SALT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10
FORM_RATE_LIMIT_WINDOW_MS=3600000
FORM_RATE_LIMIT_MAX=5

# Persistent course-thumbnail storage (required in production)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
